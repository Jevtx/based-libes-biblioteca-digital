JWT_SECRET_KEY=CHAVE-AQUI

# URL onde o frontend está sendo servido.
# Em desenvolvimento: http://localhost:5500
# Em produção (depois de publicar no Netlify): https://seu-site.netlify.app
FRONTEND_URL=http://localhost:5500

# Origens extras autorizadas a chamar esta API (separadas por vírgula).
# localhost:5500 e 127.0.0.1:5500 já são permitidos por padrão, não
# precisa repetir aqui. Em produção, coloque a URL do Netlify:
# CORS_ORIGINS=https://seu-site.netlify.app
CORS_ORIGINS=

# SMTP usado para enviar o email de recuperação.
# Exemplo para Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seuemail@gmail.com
# SMTP_PASSWORD=senha_de_app_do_gmail
# SMTP_FROM=seuemail@gmail.com

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
